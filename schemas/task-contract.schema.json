{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hu-jy23/QArborBench/schemas/task-contract.schema.json",
  "title": "QArborBench task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cell_id",
    "task_family",
    "benchmark_role",
    "candidate_contract",
    "metric",
    "adapter",
    "runner",
    "stage_policy",
    "provenance"
  ],
  "properties": {
    "cell_id": {"type": "string", "minLength": 1},
    "task_family": {"type": "string", "minLength": 1},
    "benchmark_role": {"type": "string", "minLength": 1},
    "candidate_contract": {"type": "object"},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "direction": {"enum": ["minimize", "maximize"]}
      }
    },
    "adapter": {"type": "object"},
    "runner": {"type": "object"},
    "stage_policy": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
